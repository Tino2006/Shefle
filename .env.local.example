# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe Configuration
# Get these from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
# In Vercel production, set NEXT_PUBLIC_APP_URL to your live domain
# Example: https://shefle.vercel.app

# Database Configuration (for USPTO Trademark Search)
# Get this from: https://supabase.com/dashboard/project/_/settings/database
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=your_database_connection_string

# Areeba Payment Gateway
# Test merchant: TEST222208365001 — leave hash secret + base URL blank until
# Areeba issues them. Initiate route returns 501 (GATEWAY_NOT_CONFIGURED) and
# callbacks are quarantined as `pending_verification` (never `paid`) until set.
AREEBA_MERCHANT_ID=TEST222208365001
AREEBA_API_PASSWORD=
AREEBA_HASH_SECRET=
AREEBA_GATEWAY_BASE_URL=
AREEBA_RETURN_URL=https://www.shefle.com/payment/result
AREEBA_CALLBACK_URL=https://www.shefle.com/api/payments/areeba/callback
AREEBA_CURRENCY=USD

# EUIPO Trademark Search API (IBM gateway + OAuth2 client_credentials, scope=uid)
# Server-side only — these MUST NOT be prefixed with NEXT_PUBLIC_.
# Token endpoint: HTTP Basic with EUIPO_API_KEY:EUIPO_API_SECRET, scope=uid.
# Search calls send X-IBM-Client-Id (= EUIPO_API_KEY) + Authorization: Bearer <token>.
EUIPO_API_KEY=
EUIPO_API_SECRET=
EUIPO_TOKEN_URL=https://euipo.europa.eu/cas-server-webapp/oidc/accessToken
EUIPO_API_BASE_URL=https://api.euipo.europa.eu/trademark-search

# IP Australia Trademark Search (OAuth2 client_credentials)
# Server-side only — these MUST NOT be prefixed with NEXT_PUBLIC_.
# Leave IP_AU_OAUTH_SCOPE BLANK unless IP Australia documentation tells you
# to send a specific scope: an unknown scope value causes the token endpoint
# to return 500 Internal Server Error. Same for IP_AU_TOKEN_URL /
# IP_AU_BASE_URL — keep blank to use the production defaults baked into
# lib/ipaustralia/client.ts.
IP_AU_CLIENT_ID=
IP_AU_CLIENT_SECRET=
IP_AU_TOKEN_URL=
IP_AU_BASE_URL=
IP_AU_OAUTH_SCOPE=
